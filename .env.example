# Produção (docker-compose.prod.yml, ADRs 0023 e 0024). No servidor:
#   cp .env.example .env && chmod 600 .env
# Preencha tudo. O .env é ignorado pelo git: nunca o versione nem copie para fora da instância.
# Gere os segredos com os comandos indicados. Use só letras e números nas senhas (hex): elas entram numa
# connection string, onde ";" e "=" quebram a leitura.

# Endereço público. Um domínio apontando para a instância liga o HTTPS automático (ex.: hamgueria.exemplo.com.br).
# ":80" serve HTTP pelo IP, sem conexão segura: a senha da cozinha trafega aberta.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Banco e fila (só a rede interna enxerga). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
RABBITMQ_USER=hamgueria
RABBITMQ_PASSWORD=

# Login da cozinha. Senha com pelo menos 12 caracteres e diferente de admin123 (a API não sobe se não for).
AUTH_ADMIN_USERNAME=cozinha
AUTH_ADMIN_PASSWORD=

# Chave que assina o login, com pelo menos 32 caracteres. Gere com: openssl rand -hex 32
AUTH_JWT_SECRET=

# Telemetria (ADR 0028). Para ligar o painel: docker compose -f docker-compose.prod.yml --profile observability up -d
# e descomente a linha abaixo. Vazio = sem envio.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
