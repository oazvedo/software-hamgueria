# Desenvolvimento local (backend/docker-compose.yml). Copie para backend/.env: cp .env.example .env
# Não são segredos: valem só na sua máquina. Se mudar porta ou senha aqui, ajuste também
# src/SoftwareHamgueria.API/appsettings.Development.json (ou exporte ConnectionStrings__Postgres / RabbitMq__Port).

POSTGRES_PORT=5433
POSTGRES_USER=hamgueria
POSTGRES_PASSWORD=hamgueria123

RABBITMQ_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
