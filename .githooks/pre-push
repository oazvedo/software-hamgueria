#!/bin/sh
# Recusa push para main/dev e de branch fora do padrão (ADR 0018 e 0019).
# O git passa uma linha por ref: <ref local> <sha local> <ref remota> <sha remoto>.
script="$(dirname "$0")/../scripts/git/convencao.sh"
while read -r local_ref _ remote_ref _; do
  sh "$script" push "$local_ref" "$remote_ref" || exit 1
done
