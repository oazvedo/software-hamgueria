# Copy to .env to override defaults locally.

# Use the MSW mocks (browser) instead of the real backend.
# Default (unset) = mocks ON. Set to false to hit the .NET API through the Vite proxy.
VITE_ENABLE_MOCKS=true

# Base URL for API calls (empty = same origin, uses the Vite dev proxy).
# VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api when mocks are off (defaults to the API's port).
# VITE_API_PROXY_TARGET=http://localhost:5262
