# Tela + proxy da API + HTTPS automático (ADR 0023).
# SITE_ADDRESS: um domínio (ex.: hamgueria.exemplo.com.br) liga o HTTPS com certificado automático;
# ":80" (padrão) serve HTTP pelo IP, sem conexão segura.
{
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	# API docs stay off in production (spec 004, RN-05), even if a proxy rule changes later.
	handle /swagger* {
		respond 404
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
